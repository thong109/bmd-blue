mixin policyAccordion(prefix)
	- var articles = ['Định nghĩa và giải thích từ ngữ', 'Xử lý Dữ liệu cá nhân', 'Mục đích xử lý Dữ liệu cá nhân', 'Cách thức xử lý Dữ liệu cá nhân', 'Thời gian bắt đầu, thời gian kết thúc xử lý dữ liệu', 'Chia sẻ Dữ liệu cá nhân', 'Quyền của chủ thể dữ liệu', 'Nghĩa vụ của chủ thể dữ liệu', 'Lưu trữ Dữ liệu cá nhân', 'Nghĩa vụ của Công ty', 'Hậu quả, thiệt hại không mong muốn có khả năng xảy ra', 'Quảng cáo trên internet và bên thứ ba', 'Xử lý Dữ liệu cá nhân không cần sự đồng ý của chủ thể dữ liệu', 'Thông tin liên lạc']
	.policy-accordion.js-policy-accordion
		each title, index in articles
			- var itemId = prefix + '-policy-' + (index + 1)
			.policy-accordion-item
				button.policy-accordion-button(type="button" aria-expanded=index === 0 ? 'true' : 'false' aria-controls=itemId)
					span.policy-accordion-icon(aria-hidden="true")
					span Điều #{index + 1}. #{title}
				.policy-accordion-content(id=itemId)
					.policy-accordion-inner
						if index === 0
							.paragraph-common
								p 1. Công ty tiến hành xử lý Dữ liệu cá nhân trong những trường hợp dưới đây:
								ul
									li a. Khi Khách hàng/Đối tác hoặc người đại diện hợp pháp của Khách hàng/Đối tác liên hệ với Công ty để yêu cầu tư vấn sản phẩm, dịch vụ của Công ty hoặc bày tỏ sự quan tâm tới các sản phẩm, dịch vụ của Công ty;
									li b. Khi Khách hàng/Đối tác dùng thử, ký kết hợp đồng, đăng ký, sử dụng sản phẩm, dịch vụ của Công ty;
									li c. Khi Khách hàng/Đối tác truy cập và/hoặc đăng ký tài khoản tại các website/wapsite/ứng dụng sản phẩm, dịch vụ của Công ty;
									li d. Khi Khách hàng, Đối tác đồng thuận cung cấp Dữ liệu cá nhân cho Công ty qua các nguồn công khai như: website/wapsite/ứng dụng sản phẩm, dịch vụ của Công ty; cuộc họp, sự kiện, hội thảo, hội nghị, các mạng xã hội, hay chương trình đối thoại, thảo luận do Công ty tổ chức, tài trợ hoặc tham dự và/hoặc từ các tệp lưu trữ (cookies) ghi nhận được trên website của Công ty;
									li e. Khi khách hàng, Đối tác của một tổ chức, doanh nghiệp cho phép tổ chức, doanh nghiệp đó chia sẻ dữ liệu cá nhân của khách hàng với Công ty;
									li f. Là khách hàng của một tổ chức, doanh nghiệp được Công ty thực hiện góp vốn, mua cổ phần; hoặc là khách hàng của một tổ chức, doanh nghiệp có hoạt động hợp tác cung cấp sản phẩm, dịch vụ với Công ty.
									li g. Khi có yêu cầu của các cơ quan nhà nước có thẩm quyền.
									li h. Khi công ty tiến hành các công việc theo mục đích xử lý Dữ liệu cá nhân được quy định tại Điều 3 Chính sách này.
									li i. Các trường hợp khác theo quy định của pháp luật.
								p 2. Dữ liệu cá nhân của Khách hàng/Đối tác được Công ty tiến hành xử lý (sau đây gọi tắt là “Dữ liệu cá nhân”) bao gồm những thông tin dưới đây và có thể thay đổi tùy thuộc vào loại sản phẩm hoặc dịch vụ, cách thức tương tác của Khách hàng/Đối tác với Công ty:
								p a. Dữ liệu cá nhân cơ bản:
								ul
									li – Họ, chữ đệm và tên khai sinh, tên gọi khác (nếu có);
									li – Ngày, tháng, năm sinh; ngày, tháng, năm chết hoặc mất tích;
									li – Giới tính;
									li – Nơi sinh, nơi đăng ký khai sinh, nơi thường trú, nơi tạm trú, nơi ở hiện tại, quê quán, địa chỉ liên hệ;
									li – Quốc tịch;
									li – Hình ảnh của cá nhân;
									li – Số điện thoại, số chứng minh nhân dân, số định danh cá nhân, số hộ chiếu, số giấy phép lái xe, số biển số xe, số mã số thuế cá nhân, số bảo hiểm xã hội, số thẻ bảo hiểm y tế;
									li – Tình trạng hôn nhân;
									li – Thông tin về mối quan hệ gia đình (cha mẹ, con cái);
									li – Thông tin về tài khoản số của cá nhân; dữ liệu cá nhân phản ánh hoạt động, lịch sử hoạt động trên không gian mạng;
									li – Các thông tin khác gắn liền với một con người cụ thể hoặc giúp xác định một con người cụ thể không thuộc quy định tại điểm b khoản 2 Điều này.
								p b. Dữ liệu cá nhân nhạy cảm:
								ul
									li – Dữ liệu về tội phạm, hành vi phạm tội được thu thập, lưu trữ bởi các cơ quan thực thi pháp luật;
									li – Thông tin Khách hàng/Đối tác của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài, tổ chức cung ứng dịch vụ trung gian thanh toán, các tổ chức được phép khác, gồm: thông tin định danh Khách hàng/Đối tác theo quy định của pháp luật, thông tin về tài khoản, thông tin về tiền gửi, thông tin về tài sản gửi, thông tin về giao dịch, thông tin về tổ chức, cá nhân là bên bảo đảm tại tổ chức tín dụng, chi nhánh ngân hàng, tổ chức cung ứng dịch vụ trung gian thanh toán;
									li – Dữ liệu về vị trí của cá nhân được xác định qua dịch vụ định vị.
									li – Dữ liệu cá nhân khác được pháp luật quy định là đặc thù và cần có biện pháp bảo mật cần thiết.
								p c. Công ty sẽ thông báo cho Khách hàng/Đối tác các Dữ liệu cá nhân bắt buộc phải cung cấp và/hoặc tùy chọn cung cấp tại thời điểm Khách hàng/Đối tác liên hệ, trao đổi hoặc đăng ký, ký kết hợp đồng với Công ty. Dữ liệu cá nhân bắt buộc phải cung cấp được hiểu là các Dữ liệu cá nhân mà Công ty cần phải thu thập từ Khách hàng/Đối tác theo quy định của pháp luật hoặc các Dữ liệu cá nhân thiết yếu để phục vụ việc triển khai cung cấp một phần hoặc toàn bộ sản phẩm, dịch vụ của Công ty cho Khách hàng/Đối tác.
								p d. Nếu các Dữ liệu cá nhân bắt buộc không được cung cấp theo yêu cầu của Công ty, Khách hàng/Đối tác sẽ không thể sử dụng một số sản phẩm, dịch vụ của Công ty. Trong trường hợp này, Công ty có thể từ chối cung cấp sản phẩm, dịch vụ cho Khách hàng/Đối tác mà không phải chịu bất kì một khoản bồi thường và/hoặc phạt vi phạm nào (trừ trường hợp do lỗi của Công ty).
								p e. Tại từng thời điểm, Khách hàng/Đối tác có thể tự nguyện cung cấp cho Công ty các Dữ liệu cá nhân nằm ngoài yêu cầu của Công ty. Khi Khách hàng/Đối tác cung cấp Dữ liệu cá nhân nằm ngoài yêu cầu của Công ty đồng nghĩa với việc Khách hàng/Đối tác cho phép Công ty xử lý Dữ liệu cá nhân của Khách hàng/Đối tác với mục đích được nêu trong Chính sách này hoặc với mục đích được nêu tại thời điểm Khách hàng/Đối tác cung cấp những Dữ liệu cá nhân đó. Ngoài ra, khi Khách hàng/Đối tác chủ động cung cấp thông tin nằm ngoài yêu cầu của Công ty, Khách hàng/Đối tác vui lòng không cung cấp Dữ liệu cá nhân nhạy cảm theo quy định của pháp luật tại từng thời điểm. Công ty sẽ không thực hiện xử lý và không chịu bất kì trách nhiệm pháp lý nào đối với các Dữ liệu cá nhân nhạy cảm do Khách hàng/Đối tác tự nguyện cung cấp nằm ngoài yêu cầu của Công ty.`
						else
							p Nội dung chi tiết của Điều #{index + 1} sẽ được cập nhật theo chính sách bảo vệ dữ liệu cá nhân hiện hành của Công ty.
