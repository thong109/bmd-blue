extends ../../_base/_layout.pug
block vars
  - var metaTitle = 'BLUEMARQ Development | News detail'
  - var path = '../..'
  - var page = 'news'
  - var imgPC = path + '/resources/images/news/'
  - var imgSP = path + '/resources/images/news/sp/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/sp/'
  - var videoCommon = path + '/resources/video/'

block content
  main
    section.section-news-article
      .wrapper
        .breadcrumb-common
          ol.breadcrumb-list
            li.breadcrumb-item
              a(href=path+"/news/").item-wrapper Tin tức 
            li.breadcrumb-item
              a(href=path+"/news/#tab1").item-wrapper Tin công ty
            li.breadcrumb-item
              span.item-wrapper Dòng tiền vẫn ưu tiên bất động sản trung tâm, Cloud9 Tower thu hút sự quan tâm trong ngày mở bán
        .article-wrapper
          time.article-date(datetime="18/05/2026") 18.05.2026
          h1.article-title Dòng tiền vẫn ưu tiên bất động sản trung tâm, Cloud9 Tower thu hút sự quan tâm trong ngày mở bán
          .article-post
            .post-content
              h2 Trong bối cảnh thị trường bất động sản giữa năm 2026 xuất hiện ngày càng nhiều lựa chọn ở đa dạng phân khúc và khu vực, từ các đại đô thị vùng ven đến bất động sản nghỉ dưỡng, những dự án sở hữu vị trí trung tâm hoặc liền kề trung tâm vẫn tiếp tục thu hút sự quan tâm của người mua.
              p Xu hướng này được phản ánh rõ nét tại sự kiện mở bán Cloud9 Tower thuộc khu căn hộ hạng sang The Privé do BLUEMARQ Development phát triển, diễn ra vào sáng ngày 13/6.
              h3 Nguồn cung đa dạng, dòng tiền vẫn ưu tiên tài sản có giá trị bền vững
              p Nửa đầu năm 2026 chứng kiến sự trở lại sôi động của thị trường bất động sản với hàng loạt dự án mới được giới thiệu trên nhiều địa bàn. Từ các khu đô thị quy mô lớn ở vùng ven, các dự án nhà ở tại những cực tăng trưởng mới cho đến bất động sản nghỉ dưỡng, người mua hiện có nhiều lựa chọn hơn so với giai đoạn trước.
              .wp-caption.aligncenter
                img(src=imgPC+"news_img_01.jpg" alt="Vị trí trung tâm, chất lượng bàn giao và pháp lý minh bạch là những yếu tố giúp The Privé luôn nhận được sự quan tâm lớn từ khách hàng và thị trường")
                p.wp-caption-text Vị trí trung tâm, chất lượng bàn giao và pháp lý minh bạch là những yếu tố giúp The Privé luôn nhận được sự quan tâm lớn từ khách hàng và thị trường
              p Tuy nhiên, bất động sản trung tâm vẫn duy trì sức hấp dẫn nhờ tính khan hiếm. Quỹ đất phát triển nhà ở tại khu vực lõi TP.HCM không còn nhiều, trong khi các yêu cầu về quy hoạch, pháp lý và chi phí đầu tư, xây dựng ngày càng gia tăng khiến nguồn cung mới trở nên hạn chế. Sự chênh lệch giữa nhu cầu và nguồn cung khan hiếm đang góp phần củng cố giá trị của các tài sản sở hữu vị trí trung tâm.
              p Bên cạnh đó, áp lực lãi suất và chi phí vốn cũng khiến người mua thận trọng hơn trong việc lựa chọn sản phẩm. Theo báo cáo Quý I/2026 của Savills, thị trường căn hộ TP.HCM ghi nhận khoảng 1.900 căn hộ mở bán mới với tỷ lệ hấp thụ khoảng 40%. Các chuyên gia cho rằng người mua đang có xu hướng ưu tiên những sản phẩm có giá trị sử dụng thực, pháp lý rõ ràng và khả năng bảo toàn tài sản trong dài hạn.
              p Trong bối cảnh đó, bất động sản trung tâm tiếp tục được đánh giá cao nhờ khả năng đáp ứng đồng thời nhu cầu ở thực, cho thuê và đầu tư. Chính vì vậy, dù thị trường xuất hiện ngày càng nhiều lựa chọn mới, dòng tiền vẫn có xu hướng tìm đến các dự án nằm tại khu vực trung tâm hoặc liền kề trung tâm, nơi hội tụ lợi thế về vị trí, tính thanh khoản và tiềm năng tăng trưởng bền vững.
