                  .item-content
                    p.content-title Đất Xanh chuyển mình thành BLUEMARQ GROUP - Bước tái định vị chiến lược lớn nhất trong 23 năm
                    time.content-time(datetime="20/05/2026") 20.05.2026
              li.list-item
                a.item-wrapper(href=path+"/news/detail/")
                  .item-image
                    img.object-common(src=imgPC+"news_img_03.jpg" width="432" height="288" loading="lazy" alt="The Emerald River Park – Hướng đi khác biệt của Tập đoàn Lê Phong")
                  .item-content
                    p.content-title Đất Xanh chuyển mình thành BLUEMARQ GROUP - Bước tái định vị chiến lược lớn nhất trong 23 năm
                    time.content-time(datetime="20/05/2026") 20.05.2026
              li.list-item
                a.item-wrapper(href=path+"/news/detail/")
                  .item-image
                    img.object-common(src=imgPC+"news_img_04.jpg" width="432" height="288" loading="lazy" alt="The Emerald River Park – Hướng đi khác biệt của Tập đoàn Lê Phong")
                  .item-content
                    p.content-title Đất Xanh chuyển mình thành BLUEMARQ GROUP - Bước tái định vị chiến lược lớn nhất trong 23 năm
                    time.content-time(datetime="20/05/2026") 20.05.2026
