#contactPopup.media-popup
  .popup-overlay
  .popup-box
    button.popup-close.trans
    .popup-body
      .contact-wrapper
        span.decor-common.md
        p.title-common-primary Liên hệ
        .paragraph-common
          p Vui lòng để lại thông tin, đội ngũ BLUEMARQ Development sẽ phản hồi trong thời gian sớm nhất.
        form(action="").form-common
          .form-group
            label(for="name").form-label Họ tên *
            input.input-common(type="text" name="name" id="name" required placeholder="Nhập tên của bạn")
          .form-group
            label(for="email").form-label Email *
            input.input-common(type="email" name="email" id="email" required placeholder="Nhập email của bạn")
          .form-group
            label(for="phone").form-label Điện thoại *
            input.input-common(type="text" name="phone" id="phone" placeholder="Nhập điện thoại của bạn")
          .form-group
            label(for="note").form-label Yêu cầu
            textarea.textarea-common(name="note" id="note" placeholder="Viết nội dung yêu cầu")
          .form-controller
            a.button-common-primary(href="#")
              span.button-wrapper Gửi liên hệ
