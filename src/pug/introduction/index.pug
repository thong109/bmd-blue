extends ../_base/_layout.pug
block vars
  - var metaTitle = 'BLUEMARQ Development | Introduction'
  - var path = '..'
  - var page = 'introduction'
  - var imgPC = path + '/resources/images/introduction/'
  - var imgSP = path + '/resources/images/introduction/sp/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/sp/'
  - var videoCommon = path + '/resources/video/'

block content
  main
    .slider-stage(aria-hidden="true")
      section.panel.section-introduction-about
        .group-central
          .inner
            .central-bg
              picture.about-media
                source(media="(max-width: 767.98px)" srcset=imgPC+"about_city_sp.png")
                img(src=imgPC+"about_city.png" alt="Khu đô thị hiện đại do BLUEMARQ Development phát triển" width="1920" height="1050" loading="eager")
              .wrapper
                .about-layout
                  .about-content
                    span.decor-common
                    h1.title-common-primary.hero-title Giới thiệu công ty
                    h2.about-lead.hero-sub Định hướng trở thành một trong những<br class="md"> nhà phát triển BĐS hàng đầu Đông Nam Á.
                    .paragraph-common.hero-sub
                      p BLUEMARQ Development là nhà phát triển bất động sản kế thừa hơn hai thập kỷ kinh nghiệm từ di sản Đất Xanh. Với sứ mệnh kiến tạo những giá trị sống vượt trội, chúng tôi phát triển các dự án nhà ở, thương mại và hạ tầng đô thị chuẩn mực trên khắp cả nước.
                      p Bằng tư duy dài hạn và chiến lược phát triển bền vững, BLUEMARQ Development xây dựng một hệ sinh thái bất động sản toàn diện và chuyên nghiệp.
      section.panel.section-introduction-capability
        .group-central
          .inner
            .central-bg
              .wrapper
                .capability-layout
                  .capability-intro
                    .capability-heading
                      span.decor-common
                      h1.title-common-primary Năng lực<br>phát triển toàn diện
                    .paragraph-common
                      p Từ nghiên cứu phát triển sản phẩm, ứng dụng công nghệ đến thi công và quản lý dự án, BLUEMARQ Development làm chủ toàn bộ chuỗi giá trị để mang đến những công trình chất lượng cao.
                  ul.capability-list
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_product_sp.jpg")
                        img(src=imgPC+"capability_product.jpg" alt="Phát triển sản phẩm" width="458" height="257" loading="eager")
                      .capability-card-content
                        h2.capability-card-title Phát triển sản phẩm
                        p.capability-card-description quy hoạch, thiết kế, định vị dự án.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_innovation_sp.jpg")
                        img(src=imgPC+"capability_innovation.jpg" alt="Công nghệ và đổi mới" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Công nghệ &amp; đổi mới
                        p.capability-card-description ứng dụng công nghệ tiên tiến trong phát triển.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_construction_sp.png")
                        img(src=imgPC+"capability_construction.png" alt="Thi công và quản lý dự án" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Thi công &amp; quản lý dự án
                        p.capability-card-description kiểm soát chất lượng, tiến độ, chi phí.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_product_sp.jpg")
                        img(src=imgPC+"capability_product.jpg" alt="Phát triển sản phẩm" width="458" height="257" loading="eager")
                      .capability-card-content
                        h2.capability-card-title Phát triển sản phẩm
                        p.capability-card-description quy hoạch, thiết kế, định vị dự án.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_innovation_sp.jpg")
                        img(src=imgPC+"capability_innovation.jpg" alt="Công nghệ và đổi mới" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Công nghệ &amp; đổi mới
                        p.capability-card-description ứng dụng công nghệ tiên tiến trong phát triển.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_construction_sp.png")
                        img(src=imgPC+"capability_construction.png" alt="Thi công và quản lý dự án" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Thi công &amp; quản lý dự án
                        p.capability-card-description kiểm soát chất lượng, tiến độ, chi phí.
      section.panel.section-introduction-lead#section-lead
        .group-central
          .inner
            .central-bg
              .wrapper
                .lead-layout
                  .lead-heading
                    h2.title-common-primary.hero-title Đội ngũ lãnh đạo
                    .paragraph-common.hero-sub
                      p Bằng năng lực phát triển đồng bộ cùng tư duy chiến lược, chúng tôi không chỉ kiến tạo những công trình mang dấu ấn kiến trúc mà còn góp phần hình thành các cộng đồng thịnh vượng, hiện đại và giàu bản sắc.
                  ul.lead-list.hero-sub
                    li.lead-item
                      picture.lead-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"lead_tran_ba_quan_sp.png")
                        img(src=imgPC+"lead_tran_ba_quan.png" alt="Trần Bá Quân" width="398" height="478" loading="lazy")
                      h3.lead-name Trần Bá Quân
                      p.lead-position Tổng giám đốc
                    li.lead-item
                      picture.lead-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"lead_ngo_a_bang_sp.png")
                        img(src=imgPC+"lead_ngo_a_bang.png" alt="Ngô Á Bang" width="398" height="478" loading="lazy")
                      h3.lead-name Ngô Á Bang
                      p.lead-position Phó tổng giám đốc
                    li.lead-item
                      picture.lead-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"lead_nguyen_hung_dung_sp.png")
                        img(src=imgPC+"lead_nguyen_hung_dung.png" alt="Nguyễn Hùng Dũng" width="398" height="478" loading="lazy")
                      h3.lead-name Nguyễn Hùng Dũng
                      p.lead-position Giám đốc Kinh doanh
                    li.lead-item
                      picture.lead-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"lead_pham_trung_danh_sp.png")
                        img(src=imgPC+"lead_pham_trung_danh.png" alt="Phạm Trung Danh" width="398" height="478" loading="lazy")
                      h3.lead-name Phạm Trung Danh
                      p.lead-position Giám đốc Tài chính
      section.panel.section-footer-common#section-contact
        .group-central
          .inner
            .central-bg
              .wrapper
                .footer-wrapper
                  .footer-information
                    h2.information-image
                      img.object-common(src=imgCommonPC+"header_logo.svg" alt="BLUEMARQ DEVELOPMENT" width="255" height="62" loading="eager")
                    .information-content
                      p
                        | Sẵn sàng kết nối nguồn lực, bảo chứng
                        br(clas="md")
                        | tương lai cùng BLUEMARQ Development.
                    .information-social
                      ul.social-list
                        li.social-item
                          a.item-button.is-facebook(href="#")
                        li.social-item
                          a.item-button.is-youtube(href="#")
                        li.social-item
                          a.item-button.is-instagram(href="#")
                  .footer-inner
                    .footer-contact
                      p.footer-heading TRỤ SỞ CHÍNH
                      ul.list-footer-contact
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_07.svg" alt="Địa chỉ" width="20" height="20" loading="eager")
                          .item-content
                            p
                              | Tòa nhà BLUEMARQ, 2W Ung Văn Khiêm,
                              br
                              | P. Thạnh Mỹ Tây, TP. Hồ Chí Minh, Việt Nam.
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_08.svg" alt="Trang web" width="20" height="20" loading="eager")
                          .item-content
                            a.trans(href="www.bluemarqdevelopment.com" target="_blank" rel="noopener noreferrer") www.bluemarqdevelopment.com
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_09.svg" alt="Email" width="20" height="20" loading="eager")
                          .item-content
                            a.trans(href="mailto:contact@bluemarqdevelopment.com" target="_blank" rel="noopener noreferrer") contact@bluemarqdevelopment.com
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_10.svg" alt="Số điện thoại" width="20" height="20" loading="eager")
                          .item-content
                            p Hotline: 1900 8063 | 028 6252 5252
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_12.svg" alt="Số điện thoại" width="20" height="20" loading="eager")
                          .item-content
                            p MST:
                        li.list-item
                          .item-icon
                            img.image-common(src=imgCommonPC+"social_icon_13.svg" alt="Số điện thoại" width="20" height="20" loading="eager")
                          .item-content
                            p Giờ làm việc:
                    .footer-sitemap
                      p.footer-heading LIÊN KẾT NHANH
                      ul.list-footer-sitemap
                        li.list-item
                          a.item-link(href=path+"/") Trang chủ
                        li.list-item
                          a.item-link(href=path+"/introduction/") Giới thiệu
                        li.list-item
                          a.item-link(href=path+"/projects/") Dự án
                        li.list-item
                          a.item-link(href=path+"/news/") Tin tức
                        li.list-item
                          a.item-link(href=path+"/recruitment/") Tuyển dụng
                        li.list-item
                          a.item-link(href=path+"/gallery/") Thư viện
                        li.list-item
                          a.item-link(href=path+"/contact/") Liên hệ
                  .footer-bottom
                    small.footer-copyright © 2026 BLUEMARQ Development. All rights reserved.
                    .footer-policy
                      .policy-item
                        a.item-link(href=path+"/#") Chính sách bảo mật
                      .policy-item
                        a.item-link(href=path+"/#") Điều khoản sử dụng
                      .policy-item
                        a.item-link(href=path+"/#") Sitemap
