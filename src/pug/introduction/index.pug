extends ../_base/_layout.pug
block vars
  - var metaTitle = 'BLUEMARQ Development | Introduction'
  - var path = '..'
  - var page = 'introduction'
  - var imgPC = path + '/resources/images/introduction/'
  - var imgSP = path + '/resources/images/introduction/sp/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/sp/'
  - var videoCommon = path + '/resources/video/'

block content
  main
    .slider-stage(aria-hidden="true")
      section.panel.section-introduction-about
        .group-central
          .inner
            .central-bg
              picture.about-media.ani-zoom
                source(media="(max-width: 767.98px)" srcset=imgPC+"about_city_sp.png")
                img(src=imgPC+"about_city.jpg" alt="Khu đô thị hiện đại do BLUEMARQ Development phát triển" width="1920" height="1050" loading="eager")
              .wrapper
                .about-layout
                  .about-content
                    span.decor-common
                    h1.title-common-primary.hero-title Giới thiệu công ty
                    h2.about-lead.hero-sub Định hướng trở thành một trong những<br class="md"> nhà phát triển BĐS hàng đầu Đông Nam Á.
                    .paragraph-common.hero-sub
                      p BLUEMARQ Development là nhà phát triển bất động sản kế thừa hơn hai thập kỷ kinh nghiệm từ di sản Đất Xanh. Với sứ mệnh kiến tạo những giá trị sống vượt trội, chúng tôi phát triển các dự án nhà ở, thương mại và hạ tầng đô thị chuẩn mực trên khắp cả nước.
                      p Bằng tư duy dài hạn và chiến lược phát triển bền vững, BLUEMARQ Development xây dựng một hệ sinh thái bất động sản toàn diện và chuyên nghiệp.
      section.panel.section-introduction-capability
        .group-central
          .inner
            .central-bg
              .wrapper
                .capability-layout
                  .capability-intro
                    .capability-heading
                      span.decor-common
                      h2.title-common-primary Năng lực<br>phát triển toàn diện
                    .paragraph-common
                      p Từ nghiên cứu phát triển sản phẩm, ứng dụng công nghệ đến thi công và quản lý dự án, BLUEMARQ Development làm chủ toàn bộ chuỗi giá trị để mang đến những công trình chất lượng cao.
                  ul.capability-list
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_product_sp.jpg")
                        img(src=imgPC+"capability_product.jpg" alt="Phát triển sản phẩm" width="458" height="257" loading="eager")
                      .capability-card-content
                        h2.capability-card-title Phát triển sản phẩm
                        p.capability-card-description quy hoạch, thiết kế, định vị dự án.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_innovation_sp.jpg")
                        img(src=imgPC+"capability_innovation.jpg" alt="Công nghệ và đổi mới" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Công nghệ &amp; đổi mới
                        p.capability-card-description ứng dụng công nghệ tiên tiến trong phát triển.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_construction_sp.png")
                        img(src=imgPC+"capability_construction.png" alt="Thi công và quản lý dự án" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Thi công &amp; quản lý dự án
                        p.capability-card-description kiểm soát chất lượng, tiến độ, chi phí.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_product_sp.jpg")
                        img(src=imgPC+"capability_product.jpg" alt="Phát triển sản phẩm" width="458" height="257" loading="eager")
                      .capability-card-content
                        h2.capability-card-title Phát triển sản phẩm
                        p.capability-card-description quy hoạch, thiết kế, định vị dự án.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_innovation_sp.jpg")
                        img(src=imgPC+"capability_innovation.jpg" alt="Công nghệ và đổi mới" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Công nghệ &amp; đổi mới
                        p.capability-card-description ứng dụng công nghệ tiên tiến trong phát triển.
                    li.capability-item
                      picture.capability-picture
                        source(media="(max-width: 767.98px)" srcset=imgPC+"capability_construction_sp.png")
                        img(src=imgPC+"capability_construction.png" alt="Thi công và quản lý dự án" width="458" height="257" loading="lazy")
                      .capability-card-content
                        h2.capability-card-title Thi công &amp; quản lý dự án
                        p.capability-card-description kiểm soát chất lượng, tiến độ, chi phí.
      section.panel.section-top-vision#section-introduction
        .group-central
          .inner
            .central-bg
              .wrapper
                .vision-content
                  .content-wrapper
                    span.decor-common
                    h2.title-common-primary.hero-title.js-title Tầm nhìn
                    .paragraph-common.hero-sub.js-title
                      p Trở thành Nhà phát triển Bất động sản hàng đầu Việt Nam và khu vực Châu Á – Thái Bình Dương. 
                  .content-wrapper
                    span.decor-common
                    h2.title-common-primary.hero-title.js-title Sứ Mệnh
                    h3.title-common-secondary.hero-sub.js-title Kiến tạo chuẩn mực, nâng tầm cuộc sống
                    .paragraph-common.hero-sub.js-title
                      p Nâng cao chất lượng cuộc sống &amp; hạnh phúc con người. Kiến tạo hệ sinh thái bất động sản bền vững, mang lại giá trị thực và sự thịnh vượng trọn đời cho mọi khách hàng.
      section.panel.section-top-value
        .group-central
          .inner
            .central-bg
              .wrapper
                .value-heading
                  span.decor-common-secondary
                  .heading-wrapper
                    h2.title-common-primary.is-center.hero-title.js-title Giá trị cốt lõi
                    .paragraph-common.hero-sub.js-title
                      p Bằng năng lực phát triển đồng bộ cùng tư duy chiến lược, chúng tôi không chỉ kiến tạo những công trình mang dấu ấn kiến trúc mà còn góp phần hình thành các cộng đồng thịnh vượng, hiện đại và giàu bản sắc.
                .list-top-value.hero-sub.js-title
                  ul.list-wrapper
                    li.list-item
                      .item-wrapper
                        span.item-icon
                          img.object-common(src=imgPC+"value_icon_01.svg" alt="Chất Lượng" width="89" height="89" loading="lazy")
                        .item-content
                          h3.title-common-primary.is-small Chất Lượng
                          .paragraph-common
                            p Đổi mới không ngừng, tỉ mỉ và thẩm mỹ cao trong từng thiết kế kiến trúc. Liên tục áp dụng công nghệ tiên tiến (Cutting-edge) vào phát triển dự án.
                    li.list-item
                      .item-wrapper
                        span.item-icon
                          img.object-common(src=imgPC+"value_icon_02.svg" alt="Tin Cậy" width="89" height="89" loading="lazy")
                        .item-content
                          h3.title-common-primary.is-small Tin Cậy
                          .paragraph-common
                            p Cam kết chuẩn mực, minh bạch tài chính. Sở hữu năng lực thực thi vững chắc, đảm bảo mọi dự án đều bàn giao đúng tiến độ và cam kết (Trustworthy).
                    li.list-item
                      .item-wrapper
                        span.item-icon
                          img.object-common(src=imgPC+"value_icon_03.svg" alt="Tận Tâm" width="89" height="89" loading="lazy")
                        .item-content
                          h3.title-common-primary.is-small Tận Tâm
                          .paragraph-common
                            p Chăm chút đến từng chi tiết trong không gian sống. Luôn đặt lợi ích cư dân lên hàng đầu, mang lại những di sản vượt thời gian (Dedication).
      section.panel.section-introduction-implementation
        .group-central
          .inner
            .central-bg
              .wrapper
                .implementation-layout
                  .implementation-heading
                    span.decor-common.md
                    span.decor-common-secondary.sm
                    h2.title-common-primary Năng lực triển khai
                  ul.implementation-list
